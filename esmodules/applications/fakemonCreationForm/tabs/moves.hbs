<div class="tab {{ tab.cssClass }}" data-group="{{ tab.group }}" data-tab="{{ tab.id }}">

	{{!-- CT (Capsules Techniques), sans niveau associé --}}
	<div class="form-group">
		<label>CT</label>
		<div class="form-fields">
			<div class="pk5e-move-picker" data-field="moves.tm">
				<button type="button" data-action="openCompendiumPicker" data-filter-type="move" style="padding: 0 50px;">
					<i class="fas fa-search"></i> Parcourir les capacités
				</button>
				<div class="pk5e-move-picker-tags tags"></div>
			</div>
		</div>
	</div>

	{{!-- Egg Moves --}}
	<div class="form-group">
		<label>Capacités Œuf</label>
		<div class="form-fields">
			<div class="pk5e-move-picker" data-field="moves.egg">
				<button type="button" data-action="openCompendiumPicker" data-filter-type="move" style="padding: 0 50px;">
					<i class="fas fa-search"></i> Parcourir les capacités
				</button>
				<div class="pk5e-move-picker-tags tags"></div>
			</div>
		</div>
	</div>

	{{!-- Capacités par niveau (1-20), toutes vides par défaut --}}
	{{#each moveLevels as |level|}}
	<div class="form-group">
		<label>{{ level.label }}</label>
		<div class="form-fields">
			<div class="pk5e-move-picker" data-field="moves.level.{{ level.level }}">
				<button type="button" data-action="openCompendiumPicker" data-filter-type="move" style="padding: 0 50px;">
					<i class="fas fa-search"></i> Parcourir les capacités
				</button>
				<div class="pk5e-move-picker-tags tags"></div>
			</div>
		</div>
	</div>
	{{/each}}

</div>